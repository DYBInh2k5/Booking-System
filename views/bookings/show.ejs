<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">
                    <i class="fas fa-check-circle"></i> Đặt chỗ thành công!
                </h4>
            </div>
            <div class="card-body">
                <div class="alert alert-success">
                    <strong>Mã đặt chỗ:</strong> <%= booking.booking_reference %>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <h6>Thông tin khách hàng</h6>
                        <p>
                            <strong>Họ tên:</strong> <%= user.first_name %> <%= user.last_name %><br>
                            <strong>Email:</strong> <%= user.email %>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <h6>Thông tin đặt chỗ</h6>
                        <p>
                            <strong>Trạng thái:</strong> 
                            <span class="badge bg-<%= booking.status === 'confirmed' ? 'success' : 'warning' %>">
                                <%= booking.status === 'confirmed' ? 'Đã xác nhận' : 'Chờ xác nhận' %>
                            </span><br>
                            <strong>Ngày đặt:</strong> <%= formatDateTime(booking.created_at) %>
                        </p>
                    </div>
                </div>

                <hr>

                <!-- Booking Details -->
                <% if (booking.bookable_type === 'flight') { %>
                    <h6>Chi tiết chuyến bay</h6>
                    <div class="p-3 bg-light rounded">
                        <h5><%= bookable.airline %> - <%= bookable.flight_number %></h5>
                        <p class="mb-2">
                            <strong><%= bookable.departure_city %></strong> → <strong><%= bookable.arrival_city %></strong>
                        </p>
                        <p class="mb-2">
                            <i class="fas fa-clock"></i> 
                            <%= formatDateTime(bookable.departure_time) %> - 
                            <%= formatDateTime(bookable.arrival_time) %>
                        </p>
                        <p class="mb-0">
                            <strong>Số hành khách:</strong> <%= booking.passengers_count %>
                        </p>
                    </div>
                <% } else { %>
                    <h6>Chi tiết khách sạn</h6>
                    <div class="p-3 bg-light rounded">
                        <h5><%= bookable.name %></h5>
                        <p class="mb-2">
                            <i class="fas fa-map-marker-alt"></i> <%= bookable.address %>
                        </p>
                        <p class="mb-2">
                            <strong>Nhận phòng:</strong> <%= new Date(booking.check_in_date).toLocaleDateString('vi-VN') %><br>
                            <strong>Trả phòng:</strong> <%= new Date(booking.check_out_date).toLocaleDateString('vi-VN') %><br>
                            <strong>Số đêm:</strong> <%= booking.nights %>
                        </p>
                    </div>
                <% } %>

                <% if (booking.special_requests) { %>
                    <div class="mt-3">
                        <h6>Yêu cầu đặc biệt</h6>
                        <p class="text-muted"><%= booking.special_requests %></p>
                    </div>
                <% } %>

                <hr>

                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        Tổng tiền: <span class="text-primary"><%= formatCurrency(booking.total_amount) %></span>
                    </h5>
                </div>

                <div class="mt-4 text-center">
                    <a href="/bookings" class="btn btn-primary">
                        <i class="fas fa-list"></i> Xem tất cả đặt chỗ
                    </a>
                    <a href="/" class="btn btn-outline-secondary">
                        <i class="fas fa-home"></i> Trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>