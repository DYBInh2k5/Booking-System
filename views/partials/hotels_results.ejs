<% if (hotels && hotels.length > 0) { %>
    <h4 class="mb-3">Kết quả tìm kiếm khách sạn (<%= hotels.length %> khách sạn)</h4>
    <div class="row">
        <% hotels.forEach(hotel => { %>
            <div class="col-md-6 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title"><%= hotel.name %></h6>
                        <p class="card-text">
                            <i class="fas fa-map-marker-alt"></i> <%= hotel.city %><br>
                            <% if (hotel.rating) { %>
                                <span class="text-warning">
                                    <% for(let i = 0; i < hotel.rating; i++) { %>★<% } %>
                                </span>
                            <% } %>
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="h6 text-success"><%= formatCurrency(hotel.price_per_night) %>/đêm</span>
                            <a href="/bookings/new?hotel_id=<%= hotel.id %>" class="btn btn-success btn-sm">Đặt ngay</a>
                        </div>
                        <small class="text-muted">Còn <%= hotel.available_rooms %> phòng</small>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
<% } else { %>
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> Không tìm thấy khách sạn nào phù hợp với tiêu chí tìm kiếm.
    </div>
<% } %>