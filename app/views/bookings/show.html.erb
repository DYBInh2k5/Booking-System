<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header bg-success text-white">
        <h4 class="mb-0"><i class="fas fa-check-circle"></i> Đặt chỗ thành công!</h4>
      </div>
      <div class="card-body">
        <div class="alert alert-success">
          <strong>Mã đặt chỗ:</strong> <%= @booking.booking_reference %>
        </div>

        <div class="row">
          <div class="col-md-6">
            <h6>Thông tin khách hàng</h6>
            <p>
              <strong>Họ tên:</strong> <%= @booking.user.full_name %><br>
              <strong>Email:</strong> <%= @booking.user.email %><br>
              <strong>Điện thoại:</strong> <%= @booking.user.phone %>
            </p>
          </div>
          <div class="col-md-6">
            <h6>Thông tin đặt chỗ</h6>
            <p>
              <strong>Trạng thái:</strong> 
              <span class="badge bg-<%= @booking.status == 'confirmed' ? 'success' : 'warning' %>">
                <%= @booking.status == 'confirmed' ? 'Đã xác nhận' : 'Chờ xác nhận' %>
              </span><br>
              <strong>Ngày đặt:</strong> <%= @booking.created_at.strftime("%d/%m/%Y %H:%M") %>
            </p>
          </div>
        </div>

        <hr>

        <!-- Booking Details -->
        <% if @booking.bookable.is_a?(Flight) %>
          <h6>Chi tiết chuyến bay</h6>
          <div class="p-3 bg-light rounded">
            <h5><%= @booking.bookable.airline %> - <%= @booking.bookable.flight_number %></h5>
            <p class="mb-2">
              <strong><%= @booking.bookable.departure_city %></strong> → <strong><%= @booking.bookable.arrival_city %></strong>
            </p>
            <p class="mb-2">
              <i class="fas fa-clock"></i> 
              <%= @booking.bookable.departure_time.strftime("%d/%m/%Y %H:%M") %> - 
              <%= @booking.bookable.arrival_time.strftime("%d/%m/%Y %H:%M") %>
            </p>
            <p class="mb-0">
              <strong>Số hành khách:</strong> <%= @booking.passengers_count %>
            </p>
          </div>
        <% else %>
          <h6>Chi tiết khách sạn</h6>
          <div class="p-3 bg-light rounded">
            <h5><%= @booking.bookable.name %></h5>
            <p class="mb-2">
              <i class="fas fa-map-marker-alt"></i> <%= @booking.bookable.address %>
            </p>
            <p class="mb-2">
              <strong>Nhận phòng:</strong> <%= @booking.check_in_date.strftime("%d/%m/%Y") %><br>
              <strong>Trả phòng:</strong> <%= @booking.check_out_date.strftime("%d/%m/%Y") %><br>
              <strong>Số đêm:</strong> <%= @booking.nights %>
            </p>
          </div>
        <% end %>

        <% if @booking.special_requests.present? %>
          <div class="mt-3">
            <h6>Yêu cầu đặc biệt</h6>
            <p class="text-muted"><%= @booking.special_requests %></p>
          </div>
        <% end %>

        <hr>

        <div class="d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Tổng tiền: <span class="text-primary"><%= number_to_currency(@booking.total_amount, unit: "₫", delimiter: ",") %></span></h5>
        </div>

        <div class="mt-4 text-center">
          <%= link_to "Xem tất cả đặt chỗ", bookings_path, class: "btn btn-primary" %>
          <%= link_to "Trang chủ", root_path, class: "btn btn-outline-secondary" %>
        </div>
      </div>
    </div>
  </div>
</div>