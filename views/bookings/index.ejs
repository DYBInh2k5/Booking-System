<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-calendar-check"></i> Đặt chỗ của tôi</h2>
    <a href="/search" class="btn btn-primary">
        <i class="fas fa-search"></i> Tìm kiếm thêm
    </a>
</div>

<% if (bookings && bookings.length > 0) { %>
    <div class="row">
        <% bookings.forEach(booking => { %>
            <div class="col-md-6 mb-4">
                <div class="card shadow">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">
                            <i class="fas fa-<%= booking.bookable_type === 'flight' ? 'plane' : 'hotel' %>"></i>
                            <%= booking.bookable_type === 'flight' ? 'Chuyến bay' : 'Khách sạn' %>
                        </h6>
                        <span class="badge bg-<%= booking.status === 'confirmed' ? 'success' : booking.status === 'pending' ? 'warning' : 'danger' %>">
                            <%= booking.status === 'confirmed' ? 'Đã xác nhận' : booking.status === 'pending' ? 'Chờ xác nhận' : 'Đã hủy' %>
                        </span>
                    </div>
                    <div class="card-body">
                        <% if (booking.bookable_type === 'flight') { %>
                            <h6><%= booking.bookable.airline %> - <%= booking.bookable.flight_number %></h6>
                            <p class="mb-2">
                                <strong><%= booking.bookable.departure_city %></strong> → <strong><%= booking.bookable.arrival_city %></strong>
                            </p>
                            <p class="mb-2">
                                <small class="text-muted">
                                    <%= formatDateTime(booking.bookable.departure_time) %> - 
                                    <%= formatDateTime(booking.bookable.arrival_time) %>
                                </small>
                            </p>
                        <% } else { %>
                            <h6><%= booking.bookable.name %></h6>
                            <p class="mb-2">
                                <i class="fas fa-map-marker-alt"></i> <%= booking.bookable.city %>
                            </p>
                            <p class="mb-2">
                                <small class="text-muted">
                                    <%= new Date(booking.check_in_date).toLocaleDateString('vi-VN') %> - 
                                    <%= new Date(booking.check_out_date).toLocaleDateString('vi-VN') %>
                                    (<%= booking.nights %> đêm)
                                </small>
                            </p>
                        <% } %>
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <strong class="text-primary"><%= formatCurrency(booking.total_amount) %></strong>
                            <a href="/bookings/<%= booking.id %>" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-eye"></i> Chi tiết
                            </a>
                        </div>
                        
                        <div class="mt-2">
                            <small class="text-muted">
                                Mã đặt chỗ: <strong><%= booking.booking_reference %></strong><br>
                                Đặt ngày: <%= formatDateTime(booking.created_at) %>
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
<% } else { %>
    <div class="text-center py-5">
        <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
        <h4>Chưa có đặt chỗ nào</h4>
        <p class="text-muted">Bạn chưa có đặt chỗ nào. Hãy bắt đầu tìm kiếm chuyến bay hoặc khách sạn.</p>
        <a href="/search" class="btn btn-primary">
            <i class="fas fa-search"></i> Bắt đầu tìm kiếm
        </a>
    </div>
<% } %>